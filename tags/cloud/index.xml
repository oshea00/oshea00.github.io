    <item>
      <title>AI Cloud Interactive Hype Cycle 2025</title>
      <link>https://oshea00.github.io/posts/interactive-hype-cycle/</link>
      <pubDate>Mon, 29 Sep 2025 00:00:00 +0000</pubDate>
      <guid>https://oshea00.github.io/posts/interactive-hype-cycle/</guid>
      <description>An interactive, draggable hype cycle placing 2025&amp;#39;s AI cloud technologies on the curve.</description>
      <content:encoded><![CDATA[<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
         
        #hype-cycle-widget {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: white;
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
        }

        #hype-cycle-widget * {
            box-sizing: border-box;
        }

        #hype-cycle-widget .hype-container {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 0;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }

        #hype-cycle-widget .hype-header {
            background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
            color: white;
            padding: 30px;
            text-align: center;
        }

        #hype-cycle-widget .hype-header h1 {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 10px;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        }

        #hype-cycle-widget .hype-header p {
            font-size: 1.1rem;
            opacity: 0.9;
            margin: 5px 0;
        }

        #hype-cycle-widget .hype-main-content {
            display: flex;
            flex-direction: column;
            gap: 30px;
            padding: 30px;
        }

        #hype-cycle-widget .hype-chart-section {
            background: white;
            border-radius: 15px;
            padding: 20px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            position: relative;
        }

        #hype-cycle-widget .hype-chart-container {
            position: relative;
            width: 100%;
            height: 500px;
            background: #f8f9fa;
            border-radius: 10px;
            overflow: hidden;
        }

        #hype-cycle-widget .hype-curve {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }

        #hype-cycle-widget .hype-table-section {
            background: white;
            border-radius: 15px;
            padding: 20px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }

        #hype-cycle-widget .hype-controls {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        #hype-cycle-widget .hype-search-box,
        #hype-cycle-widget .hype-filter-select {
            padding: 12px 16px;
            border: 2px solid #e1e5e9;
            border-radius: 10px;
            font-size: 14px;
            transition: all 0.3s ease;
            background: white;
        }

        #hype-cycle-widget .hype-search-box:focus,
        #hype-cycle-widget .hype-filter-select:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        #hype-cycle-widget .hype-search-box {
            flex: 1;
            min-width: 200px;
        }

        #hype-cycle-widget .hype-filter-select {
            min-width: 150px;
        }

        #hype-cycle-widget .hype-table-container {
            overflow: auto;
            max-height: 400px;
            border-radius: 10px;
            border: 1px solid #e1e5e9;
        }

        #hype-cycle-widget table {
            width: 100%;
            border-collapse: collapse;
            background: white;
        }

        #hype-cycle-widget th {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 15px 12px;
            text-align: left;
            font-weight: 600;
            cursor: pointer;
            position: sticky;
            top: 0;
            z-index: 10;
            transition: all 0.2s ease;
        }

        #hype-cycle-widget th:hover {
            background: linear-gradient(135deg, #5a6fd8 0%, #6a4190 100%);
        }

        #hype-cycle-widget td {
            padding: 12px;
            border-bottom: 1px solid #e1e5e9;
            vertical-align: top;
        }

        #hype-cycle-widget tr:hover {
            background: #f8f9ff;
        }

        #hype-cycle-widget .tech-name {
            font-weight: 600;
            color: #2c3e50;
        }

        #hype-cycle-widget .position {
            font-weight: 500;
            padding: 4px 8px;
            border-radius: 6px;
            font-size: 0.9rem;
        }

        #hype-cycle-widget .innovation-trigger { background: #e8f5e8; color: #2d5a2d; }
        #hype-cycle-widget .peak-expectations { background: #fff3cd; color: #856404; }
        #hype-cycle-widget .trough-disillusionment { background: #f8d7da; color: #721c24; }
        #hype-cycle-widget .slope-enlightenment { background: #d4edda; color: #155724; }
        #hype-cycle-widget .plateau-productivity { background: #d1ecf1; color: #0c5460; }

        #hype-cycle-widget .time-badge {
            display: inline-block;
            padding: 4px 8px;
            border-radius: 12px;
            font-size: 0.8rem;
            font-weight: 500;
        }

        #hype-cycle-widget .time-lt2 { background: #e3f2fd; color: #1565c0; }
        #hype-cycle-widget .time-2-5 { background: #e8f5e8; color: #2e7d32; }
        #hype-cycle-widget .time-5-10 { background: #fff3e0; color: #ef6c00; }
        #hype-cycle-widget .time-gt10 { background: #fce4ec; color: #c2185b; }
        #hype-cycle-widget .time-obsolete { background: #f3e5f5; color: #7b1fa2; }

        #hype-cycle-widget .analysis-cell {
            max-width: 300px;
            line-height: 1.4;
            font-size: 0.9rem;
        }

        #hype-cycle-widget .hype-tooltip {
            position: absolute;
            background: rgba(0, 0, 0, 0.9);
            color: white;
            padding: 12px 16px;
            border-radius: 8px;
            font-size: 14px;
            max-width: 300px;
            z-index: 1000;
            opacity: 0;
            transition: opacity 0.3s ease;
            pointer-events: none;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
        }

        #hype-cycle-widget .hype-tooltip.show {
            opacity: 1;
        }

        #hype-cycle-widget .tech-dot {
            position: absolute;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            cursor: pointer;
            transition: all 0.2s ease;
            z-index: 5;
        }

        #hype-cycle-widget .tech-dot:hover {
            transform: scale(1.5);
            z-index: 6;
        }

        #hype-cycle-widget .tech-dot.innovation-trigger { background: #4caf50; }
        #hype-cycle-widget .tech-dot.peak-expectations { background: #ff9800; }
        #hype-cycle-widget .tech-dot.trough-disillusionment { background: #f44336; }
        #hype-cycle-widget .tech-dot.slope-enlightenment { background: #2196f3; }
        #hype-cycle-widget .tech-dot.plateau-productivity { background: #9c27b0; }

        #hype-cycle-widget .sort-icon {
            display: inline-block;
            margin-left: 5px;
            opacity: 0.5;
        }

        @media (max-width: 768px) {
            #hype-cycle-widget .hype-header h1 {
                font-size: 1.8rem;
            }
            
            #hype-cycle-widget .hype-controls {
                flex-direction: column;
            }
            
            #hype-cycle-widget .hype-search-box,
            #hype-cycle-widget .hype-filter-select {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    
    <div id="hype-cycle-widget">
        <div class="hype-container">
            <div class="hype-header">
                <p style="font-size: 1rem; opacity: 0.8; margin-top: 10px;">Based on Gartner Hype Cycle for Cloud Platform Services, 2025</p>
                <p style="font-size: 0.8rem; opacity: 0.8; margin-top: 10px;"><i>(Hover over the dots to see details)</i></p>
            </div>
            
            <div class="hype-main-content">
                <div class="hype-chart-section">
                    <h3 style="margin-bottom: 20px; color: #2c3e50;">Technology Positioning</h3>
                    <div class="hype-chart-container">
                        <svg class="hype-curve" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none;">
                            <path d="" stroke="#3498db" stroke-width="3" fill="none" stroke-linejoin="round" stroke-linecap="round"/>
                            
                            <text x="80" y="380" text-anchor="middle" font-size="12" fill="#666">Innovation Trigger</text>
                            <text x="200" y="380" text-anchor="middle" font-size="12" fill="#666">Peak of Expectations</text>
                            <text x="350" y="380" text-anchor="middle" font-size="12" fill="#666">Trough of Disillusionment</text>
                            <text x="550" y="380" text-anchor="middle" font-size="12" fill="#666">Slope of Enlightenment</text>
                            <text x="720" y="380" text-anchor="middle" font-size="12" fill="#666">Plateau of Productivity</text>
                            
                            <text x="25" y="200" text-anchor="middle" font-size="12" fill="#666" transform="rotate(-90 25 200)">EXPECTATIONS</text>
                            
                            <text x="400" y="395" text-anchor="middle" font-size="12" fill="#666">TIME</text>
                        </svg>
                        <div class="hype-tooltip" id="hypeTooltip"></div>
                    </div>
                </div>
                
                <div class="hype-table-section">
                    <h3 style="margin-bottom: 20px; color: #2c3e50;">Technology Analysis</h3>
                    <div class="hype-controls">
                        <input type="text" class="hype-search-box" id="hypeSearchInput" placeholder="Search technologies...">
                        <select class="hype-filter-select" id="hypePositionFilter">
                            <option value="">All Positions</option>
                            <option value="Innovation Trigger">Innovation Trigger</option>
                            <option value="Peak of Inflated Expectations">Peak of Expectations</option>
                            <option value="Trough of Disillusionment">Trough of Disillusionment</option>
                            <option value="Slope of Enlightenment">Slope of Enlightenment</option>
                        </select>
                        <select class="hype-filter-select" id="hypeTimeFilter">
                            <option value="">All Timeframes</option>
                            <option value="<2 years">&lt;2 years</option>
                            <option value="2-5 years">2-5 years</option>
                            <option value="5-10 years">5-10 years</option>
                            <option value=">10 years">&gt;10 years</option>
                            <option value="Obsolete">Obsolete</option>
                        </select>
                    </div>
                    
                    <div class="hype-table-container">
                        <table id="hypeDataTable">
                            <thead>
                                <tr>
                                    <th onclick="HypeCycle.sortTable(0)">Technology <span class="sort-icon">↕</span></th>
                                    <th onclick="HypeCycle.sortTable(1)">Position <span class="sort-icon">↕</span></th>
                                    <th onclick="HypeCycle.sortTable(2)">Time to Plateau <span class="sort-icon">↕</span></th>
                                    <th onclick="HypeCycle.sortTable(3)">Analysis <span class="sort-icon">↕</span></th>
                                </tr>
                            </thead>
                            <tbody id="hypeTableBody">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const HypeCycle = (function() {
            const data = [
                {name: "Quantum Computing as a Service", position: "Innovation Trigger", time: ">10 years", analysis: "Early cloud access to quantum computers generating interest. Technology still too immature for practical applications.", x: 80, y: 300},
                {name: "AI Model Hubs", position: "Innovation Trigger", time: "5-10 years", analysis: "Centralized repositories for sharing AI models gaining momentum. Standards and governance models still developing.", x: 100, y: 280},
                {name: "Open GenAI Code Models", position: "Innovation Trigger", time: "5-10 years", analysis: "Open-source alternatives to proprietary AI models gaining traction. Very early stage with uncertain commercial viability.", x: 120, y: 260},
                {name: "Business Cloud Platform", position: "Innovation Trigger", time: "5-10 years", analysis: "Integrated platforms for business process automation emerging. Concept still evolving with limited real-world implementations.", x: 140, y: 240},
                {name: "AI Agent Development Frameworks", position: "Innovation Trigger", time: "5-10 years", analysis: "Early-stage technology with autonomous agents gaining attention. Still largely experimental with unclear practical applications.", x: 160, y: 220},
                {name: "Prompt Engineering", position: "Peak of Inflated Expectations", time: "<2 years", analysis: "Viewed as a critical new skill for AI optimization. Reality setting in about complexity and variability of results.", x: 180, y: 120},
                {name: "AI Assistants for Infrastructure as Code", position: "Peak of Inflated Expectations", time: "2-5 years", analysis: "Significant promise for automating infrastructure management. Early adopters finding gaps in reliability and context understanding.", x: 190, y: 90},
                {name: "Cloud Development Environments", position: "Peak of Inflated Expectations", time: "<2 years", analysis: "Strong interest in cloud-based IDEs and development platforms. Organizations discovering integration and performance limitations.", x: 200, y: 75},
                {name: "Intelligent Applications", position: "Peak of Inflated Expectations", time: "2-5 years", analysis: "Maximum hype around AI-powered apps with promises of revolutionary capabilities. Market excitement often exceeds current technical reality.", x: 210, y: 60},
                {name: "GenAI Application Orchestration Frameworks", position: "Peak of Inflated Expectations", time: "2-5 years", analysis: "High expectations for seamlessly integrating multiple AI models and services. Complex implementation challenges are becoming apparent.", x: 220, y: 55},
                {name: "Sovereign Cloud", position: "Peak of Inflated Expectations", time: "2-5 years", analysis: "Government and regulatory interest in data sovereignty driving hype. Technical and compliance complexities proving challenging.", x: 230, y: 52},
                {name: "AI Code Assistants", position: "Peak of Inflated Expectations", time: "2-5 years", analysis: "High expectations for productivity gains in software development. Limitations in code quality and context understanding emerging.", x: 240, y: 55},
                {name: "AI Model as a Service", position: "Peak of Inflated Expectations", time: "5-10 years", analysis: "Promise of easy AI integration through APIs creating excitement. Vendor lock-in and customization limitations becoming evident.", x: 250, y: 60},
                {name: "Internal Developer Portals", position: "Peak of Inflated Expectations", time: "2-5 years", analysis: "Expected to solve developer experience and productivity issues. Implementation complexity and adoption challenges surfacing.", x: 260, y: 70},
                {name: "SaaS Application Platform", position: "Peak of Inflated Expectations", time: "5-10 years", analysis: "Vision of unified application development and deployment platforms. Integration and migration complexities proving difficult.", x: 270, y: 85},
                {name: "Industry Cloud Platforms", position: "Peak of Inflated Expectations", time: "5-10 years", analysis: "Sector-specific cloud solutions promising rapid transformation. Customization needs and vendor dependencies creating friction.", x: 280, y: 105},
                {name: "Vector Databases", position: "Peak of Inflated Expectations", time: "5-10 years", analysis: "Essential for AI/ML applications driving high interest. Performance and scalability challenges in production environments emerging.", x: 290, y: 130},
                {name: "CloudNative", position: "Peak of Inflated Expectations", time: "5-10 years", analysis: "Containerization and microservices architecture at peak hype. Operational complexity and skills requirements becoming apparent.", x: 300, y: 155},
                {name: "Cloud Portability", position: "Trough of Disillusionment", time: "5-10 years", analysis: "Multi-cloud promises met with vendor lock-in and complexity realities. Organizations struggling with practical implementation.", x: 320, y: 190},
                {name: "Front-End Cloud", position: "Trough of Disillusionment", time: "2-5 years", analysis: "JAMstack and edge-first development showing limitations. Performance and complexity trade-offs becoming clear.", x: 330, y: 205},
                {name: "Edge PaaS", position: "Trough of Disillusionment", time: "2-5 years", analysis: "Edge computing platforms not delivering expected performance gains. Latency and management challenges proving significant.", x: 340, y: 215},
                {name: "Distributed Cloud", position: "Trough of Disillusionment", time: "5-10 years", analysis: "Hybrid cloud architectures more complex than anticipated. Integration and governance challenges causing frustration.", x: 350, y: 220},
                {name: "MACH", position: "Trough of Disillusionment", time: "2-5 years", analysis: "Microservices, API-first, Cloud-native, Headless architecture showing implementation complexity. Skills gaps and operational overhead creating disillusionment.", x: 360, y: 225},
                {name: "Data Ecosystems", position: "Trough of Disillusionment", time: "2-5 years", analysis: "Integrated data platforms not delivering seamless experiences promised. Data governance and integration proving challenging.", x: 370, y: 230},
                {name: "Enhanced Blockchain as a Service", position: "Trough of Disillusionment", time: "2-5 years", analysis: "Enterprise blockchain solutions struggling to find practical use cases. High costs and performance limitations evident.", x: 380, y: 235},
                {name: "Data Fabric", position: "Trough of Disillusionment", time: "2-5 years", analysis: "Unified data management approach facing implementation complexities. Integration across diverse systems proving difficult.", x: 390, y: 240},
                {name: "Container Management", position: "Trough of Disillusionment", time: "2-5 years", analysis: "Kubernetes and container orchestration showing steep learning curves. Operational complexity exceeding initial expectations.", x: 400, y: 245},
                {name: "Cloud Event Brokers", position: "Trough of Disillusionment", time: "2-5 years", analysis: "Event-driven architectures more complex to implement than expected. Debugging and monitoring challenges causing frustration.", x: 410, y: 250},
                {name: "Service Mesh", position: "Trough of Disillusionment", time: "2-5 years", analysis: "Microservices communication layer adding significant complexity. Performance overhead and learning curve steeper than anticipated.", x: 420, y: 248},
                {name: "Cloud Repatriation", position: "Trough of Disillusionment", time: "Obsolete", analysis: "Organizations moving workloads back on-premises due to cloud costs and complexity. Trend losing momentum as cloud economics improve.", x: 430, y: 245},
                {name: "Hybrid Cloud Computing", position: "Slope of Enlightenment", time: "2-5 years", analysis: "Mature understanding of when and how to use hybrid approaches. Tooling and practices improving significantly.", x: 480, y: 220},
                {name: "IoT PaaS", position: "Slope of Enlightenment", time: "2-5 years", analysis: "Internet of Things platforms finding stable market fit. Clear use cases and ROI models emerging.", x: 520, y: 200},
                {name: "Cloud AI Services", position: "Slope of Enlightenment", time: "2-5 years", analysis: "Pre-built AI services showing consistent value in specific domains. Organizations understanding limitations and appropriate use cases.", x: 560, y: 185},
                {name: "Data Hub PaaS", position: "Slope of Enlightenment", time: "2-5 years", analysis: "Centralized data platforms proving valuable for analytics and governance. Practical implementation patterns established.", x: 600, y: 175},
                {name: "Platform Engineering", position: "Slope of Enlightenment", time: "2-5 years", analysis: "Internal platforms improving developer experience and productivity. Clear methodologies and success patterns emerging.", x: 640, y: 170},
                {name: "Headless SaaS", position: "Slope of Enlightenment", time: "2-5 years", analysis: "API-first SaaS solutions enabling flexible integrations. Market understanding of benefits and limitations maturing.", x: 680, y: 165},
                {name: "Communications Platform as a Service", position: "Slope of Enlightenment", time: "2-5 years", analysis: "CPaaS solutions providing reliable communication capabilities. Established market with clear value propositions and use cases.", x: 720, y: 162},
                {name: "CloudNative Architecture", position: "Slope of Enlightenment", time: "2-5 years", analysis: "Best practices for cloud-native development becoming clearer. Organizations finding practical approaches to implementation.", x: 760, y: 160}
            ];

            let sortDirection = {};
            let currentData = [...data];

            function getPositionClass(position) {
                const classMap = {
                    "Innovation Trigger": "innovation-trigger",
                    "Peak of Inflated Expectations": "peak-expectations",
                    "Trough of Disillusionment": "trough-disillusionment",
                    "Slope of Enlightenment": "slope-enlightenment",
                    "Plateau of Productivity": "plateau-productivity"
                };
                return classMap[position] || "";
            }

            function getTimeClass(time) {
                if (time === "<2 years") return "time-lt2";
                if (time === "2-5 years") return "time-2-5";
                if (time === "5-10 years") return "time-5-10";
                if (time === ">10 years") return "time-gt10";
                if (time === "Obsolete") return "time-obsolete";
                return "";
            }

            function renderDots() {
                const chartContainer = document.querySelector('#hype-cycle-widget .hype-chart-container');
                const tooltip = document.getElementById('hypeTooltip');
                
                const keyPoints = [
                    data.find(item => item.name === "Quantum Computing as a Service"),
                    data.find(item => item.name === "AI Agent Development Frameworks"),
                    data.find(item => item.name === "Prompt Engineering"),
                    data.find(item => item.name === "GenAI Application Orchestration Frameworks"), 
                    data.find(item => item.name === "AI Model as a Service"), 
                    data.find(item => item.name === "Internal Developer Portals"), 
                    data.find(item => item.name === "CloudNative"),
                    data.find(item => item.name === "Cloud Portability"),
                    data.find(item => item.name === "MACH"),
                    data.find(item => item.name === "Cloud Event Brokers"),
                    data.find(item => item.name === "Cloud Repatriation"),
                    data.find(item => item.name === "Hybrid Cloud Computing"),
                    data.find(item => item.name === "Platform Engineering"),
                    data.find(item => item.name === "CloudNative Architecture")
                ].filter(Boolean).sort((a, b) => a.x - b.x);
                
                const pathSegments = keyPoints.map((point, index) => {
                    return index === 0 ? `M ${point.x} ${point.y}` : `L ${point.x} ${point.y}`;
                }).join(' ');
                
                document.querySelector('#hype-cycle-widget .hype-curve path').setAttribute('d', pathSegments);
                
                data.forEach((item) => {
                    const dot = document.createElement('div');
                    dot.className = `tech-dot ${getPositionClass(item.position)}`;
                    dot.style.left = `${item.x}px`;
                    dot.style.top = `${item.y}px`;
                    
                    dot.addEventListener('mouseenter', () => {
                        tooltip.innerHTML = `<strong>${item.name}</strong><br>${item.analysis}`;
                        
                        let tooltipX = item.x + 15;
                        let tooltipY = item.y - 10;
                        
                        if (tooltipX + 300 > chartContainer.offsetWidth) {
                            tooltipX = item.x - 315;
                        }
                        
                        if (tooltipY < 0) {
                            tooltipY = item.y + 25;
                        }
                        
                        tooltip.style.left = `${tooltipX}px`;
                        tooltip.style.top = `${tooltipY}px`;
                        tooltip.classList.add('show');
                    });
                    
                    dot.addEventListener('mouseleave', () => {
                        tooltip.classList.remove('show');
                    });
                    
                    chartContainer.appendChild(dot);
                });
            }

            function renderTable(filteredData = data) {
                const tbody = document.getElementById('hypeTableBody');
                tbody.innerHTML = '';
                
                filteredData.forEach(item => {
                    const row = document.createElement('tr');
                    row.innerHTML = `
                        <td class="tech-name">${item.name}</td>
                        <td><span class="position ${getPositionClass(item.position)}">${item.position}</span></td>
                        <td><span class="time-badge ${getTimeClass(item.time)}">${item.time}</span></td>
                        <td class="analysis-cell">${item.analysis}</td>
                    `;
                    tbody.appendChild(row);
                });
            }

            function filterData() {
                const searchTerm = document.getElementById('hypeSearchInput').value.toLowerCase();
                const positionFilter = document.getElementById('hypePositionFilter').value;
                const timeFilter = document.getElementById('hypeTimeFilter').value;
                
                const filtered = data.filter(item => {
                    const matchesSearch = item.name.toLowerCase().includes(searchTerm) || 
                                        item.analysis.toLowerCase().includes(searchTerm);
                    const matchesPosition = !positionFilter || item.position === positionFilter;
                    const matchesTime = !timeFilter || item.time === timeFilter;
                    
                    return matchesSearch && matchesPosition && matchesTime;
                });
                
                renderTable(filtered);
            }

            function sortTable(columnIndex) {
                const direction = sortDirection[columnIndex] === 'asc' ? 'desc' : 'asc';
                sortDirection[columnIndex] = direction;
                
                const sortedData = [...currentData].sort((a, b) => {
                    let aVal, bVal;
                    switch(columnIndex) {
                        case 0: aVal = a.name; bVal = b.name; break;
                        case 1: aVal = a.position; bVal = b.position; break;
                        case 2: aVal = a.time; bVal = b.time; break;
                        case 3: aVal = a.analysis; bVal = b.analysis; break;
                    }
                    
                    if (direction === 'asc') {
                        return aVal.localeCompare(bVal);
                    } else {
                        return bVal.localeCompare(aVal);
                    }
                });
                
                currentData = sortedData;
                renderTable(sortedData);
                
                document.querySelectorAll('#hype-cycle-widget .sort-icon').forEach(icon => {
                    icon.textContent = '↕';
                });
                document.querySelectorAll('#hype-cycle-widget .sort-icon')[columnIndex].textContent = 
                    direction === 'asc' ? '↑' : '↓';
            }

            function init() {
                renderDots();
                renderTable();
                
                document.getElementById('hypeSearchInput').addEventListener('input', filterData);
                document.getElementById('hypePositionFilter').addEventListener('change', filterData);
                document.getElementById('hypeTimeFilter').addEventListener('change', filterData);
            }

            return {
                init: init,
                sortTable: sortTable
            };
        })();

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', HypeCycle.init);
        } else {
            HypeCycle.init();
        }
    </script>
</body>
